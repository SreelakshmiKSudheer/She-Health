{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    // ⚠️  IMPORTANT: Always use "shehealth (web fixed port)" when running on Chrome.
    //    Using a random port causes SharedPreferences to lose saved users/session
    //    between runs because localStorage is scoped per browser origin (hostname+port).
    "configurations": [
        {
            "name": "shehealth (web fixed port)",
            "cwd": "shehealth",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--web-hostname=127.0.0.1",
                "--web-port=8011"
            ]
        },
        {
            "name": "shehealth",
            "cwd": "shehealth",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "shehealth (profile mode)",
            "cwd": "shehealth",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "shehealth (release mode)",
            "cwd": "shehealth",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}